# Copie pra .env e preencha os valores reais (.env nunca é commitado -- ver .gitignore)

# Postgres -- no Render, a variável DATABASE_URL é injetada automaticamente
# quando você linka o Web Service ao banco Postgres do mesmo projeto. Em
# desenvolvimento local, aponte pra um Postgres local ou direto pro Postgres
# de dev do Render (pegue a "External Database URL" no painel do Render).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/halloween

# Chave de sessão do Flask -- string aleatória longa, gere uma só e nunca
# reutilize entre projetos (ex.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Login com Google -- crie em https://console.cloud.google.com/apis/credentials
# (tipo "OAuth client ID", tipo de app "Web application"). Redirect URI:
# http://127.0.0.1:5000/auth/google/callback em dev, e a URL real do Render em produção.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de e-mail transacional -- API do Brevo (não é SMTP, o Render bloqueia
# SMTP de saída). Crie conta grátis em https://app.brevo.com, verifique o
# e-mail remetente (clica no link que o Brevo manda pra ele) e pegue a
# chave em SMTP & API > API Keys.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NOME="Horror Night Party"

# Chaves Pix pra gerar o QR direto na chave (sem Checkout do Mercado
# Pago) -- uma por valor possível de pedido (1 ou 2 ingressos)
PIX_KEY_30=
PIX_KEY_60=
PIX_KEY_50=

# URL base do site (usada pra montar o link de confirmação de e-mail) --
# http://127.0.0.1:5000 em dev, a URL real do Render em produção.
BASE_URL=http://127.0.0.1:5000

# Pagamento real (Pix + cartão) via Mercado Pago -- pegue no painel de
# desenvolvedores: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE primeiro (chave começa com TEST-), troque pra
# produção só quando o fluxo estiver validado.
MERCADOPAGO_ACCESS_TOKEN=

# Links de pagamento por cartão (Checkout Pro), criados manualmente no painel
# do Mercado Pago -- um para cada valor possível de pedido.
LINK_PAGAMENTO_30=
LINK_PAGAMENTO_60=
